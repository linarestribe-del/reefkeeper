{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/chat.js": {
      "maxDuration": 60
    },
    "api/observer-publish.js": {
      "maxDuration": 60
    },
    "api/observer-daily-summary.js": {
      "maxDuration": 60
    },
    "api/observer-timelapses.js": {
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/ai/(.*)",
      "dest": "/ai/$1"
    },
    {
      "src": "/css/(.*)",
      "dest": "/css/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/app.js",
      "dest": "/app.js"
    },
    {
      "src": "/observer.js",
      "dest": "/observer.js"
    },
    {
      "src": "/apex-connect.js",
      "dest": "/apex-connect.js"
    },
    {
      "src": "/apex-bridge.js",
      "dest": "/apex-bridge.js"
    },
    {
      "src": "/reef-background.png",
      "dest": "/reef-background.png"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ]
}
