[Unit]
Description=Reef Keeper Aquarium Observer Timelapse Builder
After=network-online.target reefkeeper-camera-capture.service
Wants=network-online.target
RequiresMountsFor=/mnt/reef-ssd

[Service]
Type=oneshot
User=reefkeeper
Group=reefkeeper
ExecStart=/opt/reefkeeper-observer/timelapse-builder.py

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/reefkeeper-observer
ReadWritePaths=/mnt/reef-ssd/aquarium-observer

TimeoutStartSec=20min
