# Reef Keeper Maintenance 9K — Cloudflare Worker Observer backend
# Copy to wrangler.toml in your Cloudflare Worker project and replace bucket_name.

name = "reefkeeper-observer"
main = "observer-worker.js"
compatibility_date = "2026-08-03"

[[r2_buckets]]
binding = "OBSERVER_BUCKET"
bucket_name = "reefkeeper-observer"

# Store the write token as a Worker secret, not in this file:
# npx wrangler secret put REEF_OBSERVER_WRITE_TOKEN
